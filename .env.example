# Clerk (Dashboard → API Keys)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Clerk's hosted Account Portal base URL for this instance (Dashboard → Account Portal)
CLERK_ACCOUNT_PORTAL_URL=https://accounts.your-app-name.clerk.accounts.dev

# This service's own public HTTPS URL, no trailing slash. Must be a subdomain of Clerk's
# primary domain — /callback reads Clerk's session cookie client-side, and that cookie is
# scoped to the primary domain (see README). Also used as the `iss` claim on minted
# tokens — must match LORE__SERVER__AUTH__JWT_ISSUER on the Lore server.
PUBLIC_HTTP_BASE_URL=https://lore-auth.yourcompany.com

# Bare hostname (no scheme, no port) of your Lore server — used as the `aud` claim on
# minted tokens. Confirmed by testing against the real `lore` CLI: it rejects a token
# whose iss/aud set doesn't exactly contain the domain it's connecting to
# (lore-credential/src/jwt.rs). This is a client-side check independent of whatever
# jwt_audience is (or isn't) configured on the Lore server itself.
LORE_SERVER_HOSTNAME=lore.yourcompany.com

# Must match the Lore server's own --env / LORE_ENV setting (defaults to "local" when
# unset — see the server's config reference). Required on the JWT independently of
# anything this bridge validates: loreserver's own AuthorizationToken struct
# (lore-server/src/auth/jwt.rs) fails to decode the token entirely without it. As far as
# we've found, its value isn't actually checked against anything — it just has to be
# present — so any consistent string is fine.
LORE_SERVER_ENV=local

# Only needed if the Lore server has [server.auth] jwt_audience configured — when set,
# loreserver rejects any token whose aud doesn't contain one of those values,
# independently of and in addition to LORE_SERVER_HOSTNAME above (aud carries both).
# Defaults to "lore-service", loreserver's most common default in its own tests.
LORE_SERVER_JWT_AUDIENCE=lore-service

# RSA private key (PKCS8 PEM) used to sign Lore tokens. Generate once with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt
# and paste the PEM here, keeping the newlines (or use the \n-escaped form if your
# platform's env var handling can't carry multiline values). Omitting this generates an
# ephemeral key at boot, which is fine for local dev but invalidates every outstanding
# token on each restart.
SIGNING_KEY_PEM=

# Express's port — serves /login, /callback and /.well-known/jwks.json. Plain HTTP/1.1,
# so any load balancer or reverse proxy can front it and terminate TLS upstream.
PORT=8080

# grpc-js's port and bind address. The default host is loopback because Caddy (see
# Caddyfile) runs in this same container and is the actual public listener for gRPC.
# Set GRPC_HOST=0.0.0.0 when Caddy runs as a separate container, or when your own edge
# terminates TLS and speaks gRPC directly to this port — otherwise those connections are
# refused while the HTTP side keeps working, which reads as a TLS problem rather than a
# bind-address one.
GRPC_PORT=50051
GRPC_HOST=127.0.0.1

# RebacApi (CreateResource/DeleteResource) is served on its own listener, because
# CreateResource grants the CALLER ownership of whatever resource_id the request names.
# From loreserver that is correct, since it only calls after creating the repository
# itself. From a user it is privilege escalation: present a valid login token, name
# someone else's repository ID, and you are granted owner on it. loreserver forwards the
# end user's own token on that call, so the two are indistinguishable by credentials and
# only reachability separates them.
#
# Only loreserver calls RebacApi, never the CLI. Keep this listener off the public edge:
# leave REBAC_HOST on loopback when loreserver shares this container, or set it to the
# private network address when loreserver runs elsewhere. Because loreserver uses one
# auth_url for both services, the edge must route /ucs.auth.RebacApi/* here and refuse
# it from untrusted sources; see the README.
REBAC_PORT=50052
REBAC_HOST=127.0.0.1

# Which source addresses the bundled Caddyfile accepts RebacApi calls from. Only your
# Lore server ever makes them. The default covers a Lore server on the same private
# network or compose network; when it runs elsewhere, set this to its public address or
# CIDR (a single value, e.g. 203.0.113.10/32). Leaving the default with a remote Lore
# server fails closed: `repository create` returns 403 instead of quietly leaving
# RebacApi open to any authenticated user.
LORE_SERVER_IPS=private_ranges

# Ceiling on concurrently tracked login sessions. StartAuthSession is unauthenticated by
# necessity, so this bounds what an anonymous caller can allocate. Oldest-first eviction.
MAX_SESSIONS=10000

# Per-source rate limit on the two endpoints anyone can reach: StartAuthSession (gRPC)
# and POST /callback/complete (HTTP). The latter spends a Clerk verifyToken plus a
# getUser on every call, so an unauthenticated flood burns your Clerk quota, not just
# CPU. Both limits are per source address, counted separately, and generous: a real
# login uses one call of each.
#
# The source address comes from X-Forwarded-For only when the request arrives from a
# private peer, which is what indicates it came through your proxy. Straight from the
# internet the header is ignored and the actual peer is used, so it cannot be spoofed to
# dodge the limit or to exhaust someone else's budget.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Below here: only needed when using the bundled Caddy to terminate TLS for gRPC. ---
# Skip these if your load balancer supports gRPC natively over end-to-end HTTP/2 (e.g. an
# AWS ALB gRPC target group with an ACM certificate) and talks to GRPC_PORT directly.

# Hostname the gRPC endpoint is served on, and the name Caddy obtains a certificate for.
# This is what LORE__ENVIRONMENT__ENDPOINT__AUTH_URL on the Lore server points at, as
# https://<this> - the https:// scheme is required there, since the Lore server only
# enables TLS for that literal prefix (lore-server/src/authnz/auth.rs).
GRPC_DOMAIN=lore-auth-grpc.yourcompany.com

# --- DNS-01 alternative: only if you cannot expose ports 80 and 443. ---
# By default Caddy serves this hostname on 443 and answers Let's Encrypt's HTTP-01
# challenge on 80, which needs no DNS credentials and no plugin. Some platforms only
# offer a proxy on an arbitrary port; there neither HTTP-01 (needs 80) nor TLS-ALPN-01
# (needs 443) can be solved, and DNS-01 is the only option left. That path costs a custom
# Caddy build and a DNS provider API token, so it is not the default.
#
# To use it: set CADDY_GRPC_PORT to the port your proxy forwards to, add the plugin to
# the Dockerfile (`xcaddy build --with github.com/caddy-dns/cloudflare`), and add a `tls`
# block to the Caddyfile naming your provider. CF_API_TOKEN below is for Cloudflare;
# scope it to Zone:Read + DNS:Edit on GRPC_DOMAIN's zone, since Zone:Read alone fails
# with a misleading authentication error. Other providers: https://github.com/caddy-dns
#CADDY_GRPC_PORT=8443
#CF_API_TOKEN=
