# Clerk (Dashboard → API Keys)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Clerk's hosted Account Portal base URL for this instance (Dashboard → Account Portal)
CLERK_ACCOUNT_PORTAL_URL=https://accounts.your-app-name.clerk.accounts.dev

# This service's own public HTTPS URL (Railway-assigned domain), no trailing slash.
# Also used as the `iss` claim on minted tokens — must match LORE__SERVER__AUTH__JWT_ISSUER
# on the Lore server.
PUBLIC_HTTP_BASE_URL=https://lore-clerk-bridge.up.railway.app

# Bare hostname (no scheme, no port) of your Lore server's Railway domain — used as the
# `aud` claim on minted tokens. Confirmed by testing against the real `lore` CLI: it
# rejects a token whose iss/aud set doesn't exactly contain the domain it's connecting
# to (lore-credential/src/jwt.rs). This is a client-side check independent of whatever
# jwt_audience is (or isn't) configured on the Lore server itself.
LORE_SERVER_HOSTNAME=your-lore-app.up.railway.app

# Must match the Lore server's own --env / LORE_ENV setting (defaults to "local" when
# unset — see the server's config reference). Required on the JWT independently of
# anything this bridge validates: loreserver's own AuthorizationToken struct
# (lore-server/src/auth/jwt.rs) fails to decode the token entirely without it.
LORE_SERVER_ENV=local

# RSA private key (PKCS8 PEM) used to sign Lore tokens. Generate once with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt
# and paste the PEM here (keep newlines, or use \n-escaped form — Railway supports
# multiline env var values directly). Omitting this generates an ephemeral key at
# boot, which is fine for local dev but invalidates tokens on every restart.
SIGNING_KEY_PEM=

# Internal ports. PORT (Express/Clerk) is exposed via Railway's HTTP-domain feature as
# before. GRPC_PORT (grpc-js) now binds loopback-only — Caddy (see Caddyfile) is the
# actual public listener for gRPC traffic, reachable via a Railway TCP Proxy targeting
# CADDY_GRPC_PORT, since Railway's HTTP-domain edge downgrades to HTTP/1.1 before the
# container and can't carry native gRPC's HTTP/2 framing.
PORT=8080
GRPC_PORT=50051
CADDY_GRPC_PORT=8443

# Domain the gRPC endpoint is served on — this is what LORE__ENVIRONMENT__ENDPOINT__AUTH_URL
# on the Lore server points at (ucs-auth://<this>:<TCP proxy port>). Needs a CNAME to
# the Railway TCP Proxy host Caddy is reachable through.
GRPC_DOMAIN=lore-auth-grpc.devops.crowbargames.com

# Cloudflare API token Caddy uses to complete Let's Encrypt's DNS-01 challenge for
# GRPC_DOMAIN directly against the real zone (no third-party delegation needed).
# Create at Cloudflare dashboard -> My Profile -> API Tokens -> Create Token, scoped to
# Zone:Zone:Read + Zone:DNS:Edit for just the crowbargames.com zone. Caddy obtains/
# renews the cert fully automatically from then on — no manual DNS edits, no redeploys.
CF_API_TOKEN=
